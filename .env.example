# ==============================================================================
# NEMESIS: Autonomous Cloud Resilience Engine Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GitHub Integration (For Real GitOps Pull Requests)
# ------------------------------------------------------------------------------
# Create a Personal Access Token (classic) on GitHub with 'repo' scope
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# Target repository where NEMESIS creates branches and PRs (format: owner/repo)
GITHUB_REPO=Indra-Kurkute/NEMESIS-infra

# ------------------------------------------------------------------------------
# 2. Backend Orchestrator & Server Settings
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. Real Microservices Mesh Configuration (Ports 8001 - 8008)
# ------------------------------------------------------------------------------
# Set to 'true' to spawn the 8 real microservices on ports 8001-8008
ENABLE_REAL_CLUSTER=true

# Service Port Bindings
API_GATEWAY_PORT=8001
AUTH_SERVICE_PORT=8002
PAYMENT_SERVICE_PORT=8003
ORDERS_SERVICE_PORT=8004
INVENTORY_SERVICE_PORT=8005
ORDERS_DB_PORT=8006
CACHE_SERVICE_PORT=8007
NOTIFICATION_SERVICE_PORT=8008

# Real Metrics Polling Interval (seconds)
METRICS_POLL_INTERVAL_SECONDS=1.0

# ------------------------------------------------------------------------------
# 4. Resilience & Circuit Breaker Thresholds
# ------------------------------------------------------------------------------
CIRCUIT_BREAKER_TIMEOUT_MS=30
CIRCUIT_BREAKER_MAX_RETRIES=2
CIRCUIT_BREAKER_CONSECUTIVE_5XX=3
CIRCUIT_BREAKER_BASE_EJECTION_MS=30000

# ------------------------------------------------------------------------------
# 5. Frontend Environment (Optional Vite overrides)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/events
